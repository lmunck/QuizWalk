# Non-secret Functions parameters, committed on purpose. Secrets go in Secret Manager.
# App Check enforcement is off for the user-test period (decided 2026-11-26): Play Integrity
# needs the app in the Play Console first. Set back to true once both phones attest (spec §8).
ENFORCE_APP_CHECK=false

# Gemini models (spec §8: model ids are configuration). Writer: fast; checker: a different,
# stronger model. Prices for both must be in src/llm/pricing.ts. Checked 2026-11-27.
GEMINI_WRITER_MODEL=gemini-3.8-flash
GEMINI_CHECKER_MODEL=gemini-4-argon
