<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Emulator-only config for the demo project `demo-qualk`. It holds no real IDs or keys and can
  only reach the local Firebase emulators. app.config.ts uses it until the real file from the
  Firebase console is in app/GoogleService-Info.plist.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>AIzaSyDemoKeyForLocalEmulatorsOnly00000</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.lmunck.Qualk</string>
	<key>PROJECT_ID</key>
	<string>demo-qualk</string>
	<key>STORAGE_BUCKET</key>
	<string>demo-qualk.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>CLIENT_ID</key>
	<string>000000000000-demo.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.000000000000-demo</string>
</dict>
</plist>
