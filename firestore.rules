rules_version = '2';

// M0: everything is locked. Cloud Functions use the Admin SDK and bypass these rules.
// The per-collection rules from docs/v1-spec.md §7 arrive in M1, each with tests in rules-tests/.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
